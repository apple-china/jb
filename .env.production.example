# Copy to .env.production on the server. Never commit the real file.
# The production Compose project is isolated as "jiabei-production".

PRODUCTION_DATABASE_NAME=jiabei_production
PRODUCTION_DATABASE_USER=jiabei_production
PRODUCTION_DATABASE_PASSWORD=

ALLOWED_ORIGINS=https://jbei.huixinghub.top
APP_ENTRY_URL=https://jbei.huixinghub.top

# Required only while bootstrapping a new empty production database.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_INITIAL_PASSWORD=
SUPER_ADMIN_DINGTALK_USER_ID=
SUPER_ADMIN_NICKNAME=Admin

# Reserved for a later integration phase. Keep empty in this phase.
DINGTALK_ENABLED=false
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_APP_ID=
DINGTALK_AGENT_ID=
DINGTALK_GROUP_OPEN_CONVERSATION_ID=
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_LATE_CARD_TEMPLATE_ID=
VITE_DINGTALK_CORP_ID=
VITE_DINGTALK_CLIENT_ID=

# Reserved for a later integration phase. Keep empty in this phase.
MOREDIAN_ENABLED=false
MOREDIAN_ORG_ID=
MOREDIAN_ORG_AUTH_KEY=
MOREDIAN_DEVICE_SN=
MOREDIAN_REQUIRE_SIGNATURE=true
MOREDIAN_CALLBACK_URL=
MOREDIAN_RETENTION_DAYS=180
MOREDIAN_MAX_EVENTS=60000
MOREDIAN_CLEANUP_INITIAL_DELAY_MS=300000
MOREDIAN_CLEANUP_INTERVAL_MS=604800000
