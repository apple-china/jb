# Frontend public build-time values (identifiers, not secrets).
VITE_DINGTALK_CORP_ID=
VITE_DINGTALK_CLIENT_ID=
VITE_DINGTALK_AUTO_LOGIN=false
VITE_DINGTALK_TEST_DIAGNOSTICS=false
