# DingTalk test integration (product V1.0)
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_GROUP_OPEN_CONVERSATION_ID=
DINGTALK_CARD_TEMPLATE_ID=

# Frontend public build-time values (identifiers, not secrets).
VITE_DINGTALK_CORP_ID=
VITE_DINGTALK_CLIENT_ID=

# Required only for the first production startup; never commit real values.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_INITIAL_PASSWORD=
SUPER_ADMIN_DINGTALK_USER_ID=
SUPER_ADMIN_NICKNAME=Admin

# Local/runtime overrides (keep integration values in .env.integration.local)
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
ALLOWED_ORIGINS=
UPLOAD_DIRECTORY=

# Moredian V1.0 integration (leave empty for local Mock)
MOREDIAN_ORG_ID=
MOREDIAN_ORG_AUTH_KEY=
MOREDIAN_DEVICE_SN=
MOREDIAN_REQUIRE_SIGNATURE=true
MOREDIAN_CALLBACK_URL=
